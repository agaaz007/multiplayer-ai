{
  "name": "@tranzmit/ledger",
  "version": "0.1.0",
  "description": "A shared ledger of definitions, findings, changes, and decisions that any coding agent (Claude Code, Codex, Cursor) reads before work and writes after. MCP server + CLI over plain markdown in git.",
  "type": "module",
  "bin": {
    "ledger": "./dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "guides",
    "prompts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs && chmod +x dist/cli.js",
    "build:core": "tsc -p tsconfig.core.json && tsc -p tsconfig.ui.json && node scripts/build-ui.mjs && chmod +x dist/cli.js",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node dist/selftest.js",
    "test:continuity": "node scripts/test-isolated.mjs selftest-continuity",
    "test:records": "node scripts/test-isolated.mjs selftest-records",
    "test:events": "npm run build && node dist/selftest-events.js",
    "test:resume": "node scripts/test-isolated.mjs selftest-resume",
    "test:classify": "node scripts/test-isolated.mjs selftest-classify",
    "test:recordpack": "node scripts/test-isolated.mjs selftest-recordpack selftest-embeddings",
    "test:http": "npm run build && node dist/selftest-http.js",
    "test:embeddings": "node scripts/test-isolated.mjs selftest-embeddings",
    "test:authority": "npm run build && node dist/selftest-authority.js",
    "test:capture": "npm run build && node dist/selftest-capture.js && node dist/selftest-capture-boundary.js",
    "test:investigation": "npm run build && node dist/selftest-investigation.js",
    "test:claims": "npm run build && node dist/selftest-claims.js",
    "test:graph": "npm run build && node dist/selftest-graph.js",
    "test:interpret": "npm run build && node dist/selftest-interpret.js",
    "test:findings": "npm run build && LEDGER_SELFTEST=1 node dist/selftest-findings.js",
    "test:analytical": "npm run build && node dist/eval/analytical-selftest.js",
    "test:sequences": "npm run build && node dist/eval/sequence-selftest.js",
    "test:analytical-native-capture": "npm run build && node dist/selftest-eval-ledger-native.js",
    "benchmark:analytical": "node dist/eval/analytical-runner.js",
    "test:all": "node scripts/test-isolated.mjs",
    "preview:ui": "npm run build && node scripts/preview-ui.mjs",
    "prepare": "npm run build",
    "test:analytical-competitors": "npm run build && node dist/eval/analytical-competitors-selftest.js",
    "test:production": "node scripts/test-isolated.mjs selftest-availability selftest-binding-usage selftest-production",
    "test:timeline": "node scripts/test-isolated.mjs selftest-timeline"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "boxen": "8.0.1",
    "gray-matter": "^4.0.3",
    "pg": "^8.23.0",
    "supermemory": "4.25.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "typescript": "^7.0.2"
  }
}
